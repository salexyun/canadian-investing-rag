# Host virtualenv -- built for the host OS/arch (macOS here), not the
# container's. `uv sync` inside the image builds its own; copying this in
# would also balloon the build context by >1GB for nothing.
.venv

# Secrets -- supplied at runtime via docker-compose's env_file, never
# baked into an image layer.
.env

.git
.gitignore
__pycache__
*.pyc
.DS_Store

# Data -- always bind-mounted at runtime (./data for the app, the flow's
# repo_root/data for ingestion tasks), never baked in. Baking it in once
# hid a real bug: Kestra was silently dropping the ingestion tasks' mount,
# and the flow still "succeeded" against the stale copy inside the image.
data/
